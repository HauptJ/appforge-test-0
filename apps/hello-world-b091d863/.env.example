# Local development only. Real values live in HashiCorp Vault at
# apps/hello-world-b091d863/<credential-name>.
# Copy to .env and fill in. Do NOT commit .env.

# --- Non-secret configuration ---
ENVIRONMENT=development
DOCS_ENABLED=false
ALLOWED_ORIGINS=http://localhost:8080
SERVE_OVER_TLS=false

SESSION_COOKIE_NAME=hw_session
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_MINUTES=480

# OIDC - supply the issuer / client ID for your org IdP.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_REDIRECT_URL=http://localhost:8080/api/v1/auth/callback
OIDC_SCOPES=openid profile email

# Development-only sign-in bypass (NEVER true in production).
AUTH_DEV_BYPASS=false
DEV_USER_EMAIL=dev@example.com
DEV_USER_NAME=Dev User

LOG_LEVEL=INFO

# --- HashiCorp Vault (used in staging and production) ---
VAULT_ADDR=
VAULT_ROLE_ID=
# Prefer VAULT_SECRET_ID_FILE and mount the file as a container secret.
VAULT_SECRET_ID=
VAULT_SECRET_ID_FILE=
VAULT_KV_MOUNT=apps
VAULT_APP_PATH=hello-world-b091d863

# --- Local development fallback (used only when VAULT_ADDR is empty) ---
# Set this to "true" to allow reading the two secrets below from env vars instead of Vault.
ALLOW_ENV_CREDENTIALS=false

# local development only - real value lives in Vault at apps/hello-world-b091d863/session-signing-key
SESSION_SIGNING_KEY=
# local development only - real value lives in Vault at apps/hello-world-b091d863/oidc-client-secret
OIDC_CLIENT_SECRET=
